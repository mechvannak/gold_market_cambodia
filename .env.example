# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL where this server is reachable (Telegram Mini Apps require HTTPS).
# Example: https://gold.example.com  (the Mini App is served at /app/)
WEBAPP_URL=

# Claude API key, used to read and score news headlines.
# Without it the app falls back to a simple keyword scorer (less accurate).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: comma-separated Telegram user IDs allowed to use the bot / Mini App.
# Empty = anyone who finds the bot.
ALLOWED_USER_IDS=

# Local testing only: skip Telegram signature check on the API (never use in production).
DEV_MODE=0

PORT=8080
CACHE_TTL_SECONDS=600

# Daily forecast alert for /subscribe users (local hour, 0-23) and timezone
ALERT_HOUR=8
TIMEZONE=Asia/Bangkok
